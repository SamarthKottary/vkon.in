# Copy to `.env` on the server (next to docker-compose.yml) and fill in.
# `chmod 600 .env`. Never commit it.
#
# ⚠️  Do not use values containing `$` — Docker Compose interpolates them and
#     will silently mangle the value. Generate secrets with the commands below,
#     which produce hex/base64 output that is always safe.

# Postgres password for the bundled database container.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The password you type at https://vkon.in/admin
ADMIN_PASSWORD=

# Signs the admin session cookie. 16+ chars; anyone who knows it can mint a
# valid admin session.
#   openssl rand -hex 32
AUTH_SECRET=

# Host port the container binds on 127.0.0.1. Check it is free: ss -ltn
APP_PORT=8120

# Public origin, used for canonical URLs, sitemap and structured data.
SITE_URL=https://vkon.in

# ---------------------------------------------------------------------------
# Local development without Docker
# ---------------------------------------------------------------------------
# Use .env.local instead, pointing at whatever Postgres you run locally:
#   DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/vkon
#   ADMIN_PASSWORD=dev-password
#   AUTH_SECRET=dev-secret-at-least-16-chars
