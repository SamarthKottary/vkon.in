# Copy to `.env` on the server (next to docker-compose.yml) and fill in.
# `chmod 600 .env`. Never commit it.
#
# ⚠️  Do not use values containing `$` — Docker Compose interpolates them and
#     will silently mangle the value. Generate secrets with the commands below,
#     which produce hex/base64 output that is always safe.

# Postgres password for the bundled database container.
#   openssl rand -hex 24
#
# ⚠️  Set this ONCE, before the first deploy. Postgres only applies it when it
#     initialises an empty data directory — changing it later does nothing to
#     the database but does change what the app sends, so every query then
#     fails with "password authentication failed". To rotate it properly see
#     DEPLOYMENT.md → Troubleshooting.
POSTGRES_PASSWORD=

# The password you type at https://vkon.in/admin
ADMIN_PASSWORD=

# Signs the admin session cookie. 16+ chars; anyone who knows it can mint a
# valid admin session.
#   openssl rand -hex 32
AUTH_SECRET=

# Host port the container binds on 127.0.0.1. Check it is free: ss -ltn
APP_PORT=8120

# Public origin, used for canonical URLs, sitemap and structured data.
SITE_URL=https://vkon.in

# ---------------------------------------------------------------------------
# Customer accounts — email (Resend)
# ---------------------------------------------------------------------------
# Registration, password reset and order confirmations go through Resend's
# plain HTTPS API — no npm package, which is why it was chosen over SMTP.
#
# LEAVING THIS BLANK IS SUPPORTED: the message is written to the server log
# instead of sent, and everything else works. That is what local development
# uses. In production it means a customer never receives their reset link.
RESEND_API_KEY=
MAIL_FROM=Vkon Automation <no-reply@vkon.in>

# ---------------------------------------------------------------------------
# Customer accounts — Continue with Google
# ---------------------------------------------------------------------------
# Optional. Leave blank and the Google button does not render; registering
# with a password still works. See docs/SETUP-GUIDE.md §3.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development only — overrides the redirect URI, which is otherwise built from
# SITE_URL. Leave blank on the server.
#   GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Razorpay — taking payment
# ---------------------------------------------------------------------------
# Optional. Leave blank and the "Pay now" button does not render; orders are
# placed unpaid and settled on a phone call. See docs/SETUP-GUIDE.md §4.
#
# The Key ID is PUBLIC and reaches the browser by design. The two secrets do
# not. The webhook secret is a DIFFERENT value you invent yourself.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Shiprocket — delivery rates, booking and tracking
# ---------------------------------------------------------------------------
# Optional. Leave blank and checkout shows "Quoted on our call" exactly as it
# did before, and /admin/orders shows no "Book shipment" button. Nothing else
# changes. See docs/SHIPPING.md and docs/SETUP-GUIDE.md §5.
#
# EMAIL/PASSWORD are the API-user credentials created under
# Settings -> API -> Configure, NOT your dashboard login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# The PIN code the parcels go out from. This is the origin every rate is
# calculated from, so it must be the real pickup address, not the office.
SHIPROCKET_PICKUP_PINCODE=

# The nickname of that address exactly as it appears in Shiprocket's
# Settings -> Pickup Addresses. Defaults to "Primary", which is what a fresh
# account calls its first one.
SHIPROCKET_PICKUP_LOCATION=

# A value you invent, then paste into Shiprocket's webhook settings. Their
# webhook sends it back in the x-api-key header and it is the only thing
# authenticating that request — treat it like a password.
SHIPROCKET_WEBHOOK_TOKEN=

# Optional. The address the courier sends its own delivery notifications to.
# Falls back to the site's contact address.
SHIPROCKET_NOTIFY_EMAIL=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel — server only, leave blank for local development
# ---------------------------------------------------------------------------
# Token from the client's Cloudflare account:
#   Zero Trust -> Networks -> Tunnels -> your tunnel -> the string after --token
#
# Setting COMPOSE_PROFILES=tunnel is what starts the connector container. Do NOT
# run `cloudflared service install` on this host — the systemd unit of that name
# belongs to the PTZ tunnel and would be overwritten.
TUNNEL_TOKEN=

# Uncomment ONLY after TUNNEL_TOKEN is filled in above. Enabling it with an
# empty token starts a connector that cannot authenticate and restarts forever.
#COMPOSE_PROFILES=tunnel

# ---------------------------------------------------------------------------
# Local development without Docker
# ---------------------------------------------------------------------------
# Use .env.local instead, pointing at whatever Postgres you run locally:
#   DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/vkon
#   ADMIN_PASSWORD=dev-password
#   AUTH_SECRET=dev-secret-at-least-16-chars
