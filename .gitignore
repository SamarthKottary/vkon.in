# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never tracked, the template always is.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Deploy console contract — host-side only, never tracked.
cicd/
/data/

# Infrastructure notes — NOT for a public repo.
# Hosting.md and cicd.md contain Cloudflare tunnel UUIDs, internal hostnames and
# host filesystem paths for the deploy machine. Poster.pdf is 11 MB of a
# competitor's marketing material.
# If this repo is private and you want them tracked, delete these three lines.
docs/Hosting.md
docs/cicd.md
docs/Poster.pdf

# A clone of this repo made inside itself (easy to do when following
# DEPLOYMENT.md Step 2 on the wrong machine). Nested repos get committed as a
# gitlink, which is never what anyone wants.
/vkon.in/

# Exported DNS zone files. They carry the Cloudflare tunnel UUID and the full
# record set — infrastructure detail that has no business in a public repo.
*.txt
!requirements.txt

# Source logo artwork. The processed transparent PNGs in public/brand ship.
vkon_logo.jpeg
